{
  "name": "Programando com CRUSH",
  "initializeCommand": "./.devcontainer/image-build.sh",
  "dockerComposeFile": "./docker-compose.yml",
  "workspaceFolder": "/workspace",
  "service": "dev",
  "containerEnv": {
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}",
    "OPENROUTER_API_KEY": "${localEnv:OPENROUTER_API_KEY}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dustypomerleau.rust-syntax",
        "rust-lang.rust-analyzer",
        "mhutchie.git-graph",
        "MS-CEINTL.vscode-language-pack-pt-BR",
        "natqe.reload",
        "rufuswein.saveall",
        "Codeium.codeium",
        "usernamehw.errorlens",
        "zwyx.remotetrash"
      ],
      "unwantedRecommendations": [
        "1YiB.rust-bundle",
        "GitHub.copilot-chat",
        "serayuzgur.crates"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "rust-analyzer.checkOnSave.command": "clippy",
        "rust-analyzer.cargo.allFeatures": true
      }
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "source=${env:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind",
    "source=${env:HOME}/.ssh,target=/home/vscode/.ssh,type=bind"
  ],
  // "postCreateCommand": "rustc --version && cargo --version",
  "remoteUser": "vscode"
}