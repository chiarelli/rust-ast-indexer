{
  "$schema": "https://charm.land/crush.json",
  "mcp": {
    "text-editor": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-text-editor"
      ],
      "timeout": 120
    },
    "qdrant": {
      "type": "stdio",
      "command": "node",
      "args": [
        "--env-file=./.mcp-tools/qdrant-mcp-server/.env",
        "./.mcp-tools/qdrant-mcp-server/build/index.js"
      ],
      "timeout": 120,
      "disabled_tools": [
        "add_documents",
        "delete_documents",
        "clear_index",
        "get_index_status",
        "index_git_history",
        "search_git_history",
        "index_new_commits",
        "get_git_index_status",
        "clear_git_index",
        "contextual_search",
        "federated_search",
        "semantic_search"
      ]
    }
  },
  "providers": {
    "openrouter-free": {
      "type": "openai-compat",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key": "$OPENROUTER_API_KEY",
      "models": [
        {
          "id": "qwen/qwen3.6-plus-preview:free",
          "name": "Qwen3.6 Plus Preview",
          "cost_per_1m_in": 0.27,
          "cost_per_1m_out": 1.1,
          "cost_per_1m_in_cached": 0.07,
          "cost_per_1m_out_cached": 1.1,
          "context_window": 400000,
          "default_max_tokens": 98000
        },
        {
          "id": "qwen/qwen3-coder:free",
          "name": "Qwen: Qwen3 Coder 480B A35B (free)",
          "cost_per_1m_in": 0.27,
          "cost_per_1m_out": 1.1,
          "cost_per_1m_in_cached": 0.07,
          "cost_per_1m_out_cached": 1.1,
          "context_window": 262000,
          "default_max_tokens": 64000
        },
        {
          "id": "nvidia/nemotron-3-super-120b-a12b:free",
          "name": "NVIDIA: Nemotron 3 Super (free)",
          "cost_per_1m_in": 0.27,
          "cost_per_1m_out": 1.1,
          "cost_per_1m_in_cached": 0.07,
          "cost_per_1m_out_cached": 1.1,
          "context_window": 262000,
          "default_max_tokens": 32000
        }
      ]
    }
  },
  "options": {
    "debug": true,
    "skills_paths": [
      "./.project-skills"
    ]
  }
}